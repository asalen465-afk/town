function setLang(l){
  const d=T[l];
  document.documentElement.lang=l;
  document.documentElement.dir=l==='ar'?'rtl':'ltr';
  document.querySelectorAll('[data-i18n]').forEach(e=>e.textContent=d[e.dataset.i18n]);
  document.getElementById('langBtn').textContent=d.btn;
  document.title=l==='ar'?'عيادات تاون كلينك | Town Clinic':'Town Clinic | عيادات تاون كلينك';
  const list=document.getElementById('specList'),s=window.SPECIALTIES||[];
  list.innerHTML='';
  s.forEach(x=>{const li=document.createElement('li');li.textContent=x[l];list.appendChild(li)});
  document.getElementById('specialties').hidden=!s.length;
  try{localStorage.setItem('tc_lang',l)}catch(e){}
}
let cur='ar';
try{cur=localStorage.getItem('tc_lang')||'ar'}catch(e){}
document.getElementById('langBtn').onclick=()=>{cur=cur==='ar'?'en':'ar';setLang(cur)};
setLang(cur);
